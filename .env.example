# Copy this file to .env and fill in your details. Never commit .env.

# Port for the Node server
PORT=3001

# Password for the admin portal (open the site at #admin). Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Only needed if the website is hosted somewhere else (e.g. GitHub Pages)
# ALLOWED_ORIGIN=https://your-username.github.io
